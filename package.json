{
  "name": "kaleo-checkin-desktop",
  "productName": "Kaleo Checkin Desktop",
  "version": "0.4.2",
  "description": "Casca desktop do totem de check-in do Kaleo, com impressão silenciosa de etiquetas.",
  "author": "Sistema Kaleo",
  "private": true,
  "main": "src/main.js",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "br.com.sistemakaleo.checkin-desktop",
    "productName": "Kaleo Checkin Desktop",
    "copyright": "Sistema Kaleo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kaleo Checkin Desktop",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Kaleo-Checkin-Desktop-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sistema-Kaleo",
        "repo": "Sistema-Kaleo-Checkin-Desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
